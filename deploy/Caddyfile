# ADR-004: TLS терминирует host-nginx (certbot), caddy — внутренний
# reverse-proxy стека, HTTP-only, опубликован на 127.0.0.1:${HTTP_PORT}.
# При переезде на чистый VPS: вернуть {$DOMAIN} вместо :80 — caddy сам
# поднимет Let's Encrypt.

{
	auto_https off
}

:80 {
	# S3-6: ретранслятор доски (ADR-020) — только участникам незавершённого
	# урока. forward_auth спрашивает api (сессия из cookie, урок из пути),
	# потом путь урока срезается: ретранслятор слушает /socket.io/.
	# route держит порядок: иначе rewrite сработал бы раньше forward_auth,
	# и api не увидел бы урок в X-Forwarded-Uri.
	# forward_auth видит только рукопожатие, поэтому WebSocket живёт не
	# дольше stream_timeout: клиент переподключается и проходит проверку
	# заново — отключённый или выбывший участник теряет доску в пределах
	# 10 минут (ADR-020)
	@whiteboard path_regexp ^/whiteboard/lesson-[0-9]+/socket\.io/$
	handle @whiteboard {
		route {
			forward_auth api:8080 {
				uri /whiteboard/auth
			}
			rewrite * /socket.io/?{query}
			reverse_proxy whiteboard:3002 {
				stream_timeout 10m
			}
		}
	}

	# /api/* → api; префикс стрипается, внутри api пути без /api
	# (контракт — docs/architecture/04-api.md)
	handle_path /api/* {
		reverse_proxy api:8080
	}

	# всё остальное → web (Next.js)
	handle {
		reverse_proxy web:3000
	}
}
