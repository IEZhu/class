# Шаблон окружения. Реальные значения — в deploy/.env (не коммитится).
# Каждый новый ключ: сначала сюда + в «Факт» плана этапа (deploy/README.md).

# --- Этап 0 (S0-1) ---

# Домен стенда; TLS терминирует host-nginx — ADR-004
DOMAIN=lang.wondermr.com
# Loopback-порт, на котором caddy стека опубликован для host-nginx (ADR-004)
HTTP_PORT=8090

# Postgres (внутри compose-сети, наружу не публикуется)
POSTGRES_DB=lingua
POSTGRES_USER=lingua
POSTGRES_PASSWORD=change-me

# --- Этап 0 (S0-3) ---
# SESSION_SECRET, заложенный планом на S0-1, удалён: при серверных
# cookie-сессиях (ADR-006) подпись не нужна.

# Пароль seed-пользователей (teacher@lingua.local и т.д.) для make seed.
# Опционален: пусто — seed пароли не задаёт (логин невозможен).
# Дефолт намеренно пустой: репозиторий публичный, известный пароль
# из шаблона стал бы рабочим кредом стенда.
SEED_PASSWORD=

# LiveKit Cloud (S1-4): комната урока. Проект → Settings → Keys.
# URL вида wss://<project>.livekit.cloud. Те же ключи у worker'а: уборка
# записей останавливает Egress после окна комнаты (ADR-031)
LIVEKIT_URL=change-me
LIVEKIT_API_KEY=change-me
LIVEKIT_API_SECRET=change-me

# Хранилище записей — Cloudflare R2 (ADR-009), API S3-совместимый.
# Бакет настраивается скриптом deploy/s3-bootstrap.sh, токен — в кабинете
# Cloudflare (Object Read & Write, scope — только этот бакет).
# Регион у R2 всегда auto (пусто — то же самое). Возврат на AWS — очистить
# S3_ENDPOINT и указать реальный регион, код менять не нужно: без endpoint
# api и worker с пустым регионом или auto не стартуют.
S3_BUCKET=change-me
S3_REGION=auto
S3_ENDPOINT=https://change-me.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me

# 1 — писать только звук: на порядок дешевле, для транскрипта достаточно.
# Пусто или 0 — писать видео (05-storage-s3.md).
EGRESS_AUDIO_ONLY=

# Бэкапы Postgres (S1-7, ADR-014): deploy/backup-pg.sh по таймеру,
# deploy/restore-pg.sh для восстановления; копии — backups/pg/<дата>.dump.zst.
# Все пусты — берутся S3_* выше: тот же бакет и тот же токен, что уходит
# в LiveKit Egress и умеет читать и удалять дампы (в журнале будет
# предупреждение, долг D-8). Нужно — отдельный бакет и отдельный токен
# Object Read & Write только на него. Задан хоть один ключ ниже —
# BACKUP_S3_BUCKET обязателен и не может быть бакетом записей на том же
# эндпоинте: иначе скрипты падают. Эндпоинт и регион, если пусты, — из S3_*;
# пара ключей — только целиком, пустая — из S3_* (с предупреждением).
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# Google Calendar преподавателей (S1-1, ADR-023): уроки событиями в их
# календари, участники получают приглашения. Опционально: пока пусто
# хоть одно — подключение на /account недоступно, calendar_sync пропускает
# уроки. OAuth-клиент (тип Web application) — по шагам в deploy/README.md,
# redirect URI — https://<DOMAIN>/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Ключ шифрования refresh-токенов (AES-256-GCM): openssl rand -base64 32.
# Смена ключа = все преподаватели подключают календарь заново (ADR-023).
GOOGLE_TOKEN_KEY=

# Транскрибация AssemblyAI (S2-1…S2-3, ADR-015). Пусто — транскрипта нет,
# урок с записью сразу done, остальной стенд работает. Ключ — кабинет
# AssemblyAI → API Keys; нужен worker'у. С ключом worker требует и секрет
# вебхука, и хранилище S3_* выше: AssemblyAI скачивает запись по ссылке
# на сутки и шлёт итог на https://<DOMAIN>/api/webhooks/assemblyai.
ASSEMBLYAI_API_KEY=
# Секрет вебхука (не короче 32 символов): worker передаёт его AssemblyAI,
# api сверяет в заголовке X-Lingua-Webhook-Secret. Сгенерировать:
# openssl rand -hex 32. Пусто — вебхук отвечает 503.
ASSEMBLYAI_WEBHOOK_SECRET=

# --- Этап 3 (S3-3): перевод слов LibreTranslate (ADR-018) ---
# Сервис libretranslate — в профиле translate: включить им
# COMPOSE_PROFILES=translate, один раз поставить модели (deploy/README.md)
# и задать адрес. Пусто — клик по слову отвечает дефинициями без перевода.
COMPOSE_PROFILES=
LIBRETRANSLATE_URL=

# --- Этап 3 (S3-6): доска Excalidraw (ADR-020) ---
# Ретранслятор доски — сервис whiteboard в профиле compose «whiteboard».
# Его образ не проходит блокирующий скан ADR-011 (долг D-11), поэтому
# доска включается явно, обеими строками:
#   COMPOSE_PROFILES=whiteboard   (строка в блоке S3-3 выше; профили
#                                  через запятую: translate,whiteboard)
#   WHITEBOARD_ENABLED=1          (api пускает к доске)
# Пусто — доска отвечает 503, остальной стенд работает. Снимки сцен
# worker пишет в хранилище S3_* выше: whiteboards/<lesson_id>.json.
# WebSocket через host-nginx требует заголовков Upgrade в его vhost
# (deploy/README.md, «Доска»), иначе socket.io ходит long-polling'ом.
WHITEBOARD_ENABLED=

# --- Этап 5 (S5-1/S5-2): сборщик субтитров (ADR-022) ---
# Сервис harvester под профилем compose, make up его не поднимает:
# docker compose -f deploy/docker-compose.yml --profile harvester up -d --build harvester
# Cookies YouTube — только если начнутся проверки «вы не бот»: абсолютный
# путь к файлу cookies в формате Netscape на хосте, читаемому uid 10001
# контейнера (chown 10001 <файл> && chmod 600 <файл>). Пусто — без cookies.
HARVESTER_COOKIES_FILE=
# Своя роль базы сборщика — только его таблицы (yt-dlp в том же контейнере
# видит этот DSN). Пароль — openssl rand -hex 32; роль создаёт
# deploy/harvester-db-role.sh (deploy/README.md). Пусто — DSN владельца:
# postgres://lingua_harvester:<пароль>@postgres:5432/lingua?sslmode=disable
HARVESTER_DATABASE_URL=

# --- Этап 5 (S5-6): LLM-генерация текстов (ADR-029) ---
# Нужно только api. Пусто LLM_API_KEY — POST /practice/generate-text
# отвечает 503 «LLM не настроен», остальной стенд работает.
# Провайдер: anthropic (по умолчанию) | openai | deepseek; ключ — из
# кабинета выбранного провайдера, только для api этого стенда.
LLM_PROVIDER=
LLM_API_KEY=
# Модель; пусто — самая дешёвая актуальная модель провайдера:
# claude-haiku-5-5 | gpt-6-luna | deepseek-flash (ADR-029).
LLM_MODEL=
# Генераций на пользователя в сутки (UTC); пусто — 10. Генерация —
# один или два вызова провайдера (ретрай валидатора покрытия).
LLM_DAILY_LIMIT=

# --- Этап 5 (S5-8): «объясни» в попапе слова (ADR-039) ---
# Ключи провайдера — LLM_* выше; без LLM_API_KEY кнопки нет, а
# POST /terms/{id}/explain отвечает 503. Объяснений на пользователя в
# сутки (UTC), отдельно от генераций; пусто — 30. Повтор того же слова в
# том же предложении берётся из кэша и лимит не тратит.
LLM_EXPLAIN_DAILY_LIMIT=
